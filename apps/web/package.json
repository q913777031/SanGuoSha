{
  "name": "@sgs/web",
  "version": "0.0.0",
  "private": true,
  "description": "三国杀网页客户端(手机优先,PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
